# Supabase auth/session features
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side APIs. Do not expose these with NEXT_PUBLIC_.
TOUR_API_KEY=your-tourapi-key
YOUTUBE_API_KEY=your-youtube-api-key
OPENAI_API_KEY=your-openai-api-key
KAKAO_MAP_REST_KEY=your-kakao-rest-api-key

# Upstash Redis L2 cache
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Client-side app settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kakao Maps JavaScript SDK key.
# Enable Kakao Map/Local for the app and register http://localhost:3000 plus your deployed origin.
# Leave empty to keep the no-cost local map preview fallback.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# AI worker gate
ENABLE_AI_WORKER_ANALYSIS=false
AI_WORKER_URL=

# ── AI Worker (ai-worker/.env or environment variables) ──────────────────────
# Google Gemini (fallback if Groq is not set)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Groq (primary AI provider — free tier: 14,400 req/day)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# YouTube Data API v3 — fetches video title + description (transcript works without this)
# Get a key at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_DATA_API_KEY=your-youtube-data-api-key

# Kakao REST API key — used for place geocoding in SpotExtractorService
# Same key as KAKAO_MAP_REST_KEY above (ai-worker reads its own copy)
KAKAO_MAP_REST_KEY=your-kakao-rest-api-key
