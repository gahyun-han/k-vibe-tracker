# Supabase auth/session features
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side APIs. Do not expose these with NEXT_PUBLIC_.
TOUR_API_KEY=your-tourapi-key
YOUTUBE_API_KEY=your-youtube-api-key
OPENAI_API_KEY=your-openai-api-key
KAKAO_MAP_REST_KEY=your-kakao-rest-api-key

# Upstash Redis L2 cache
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Client-side app settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kakao Maps JavaScript SDK key.
# Register http://localhost:3000 and your deployed origin in Kakao Developers.
# Leave empty to keep the no-cost local map preview fallback.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# AI worker gate
ENABLE_AI_WORKER_ANALYSIS=false
AI_WORKER_URL=
